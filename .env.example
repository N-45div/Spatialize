VITE_API_BASE_URL=
VITE_B2_PUBLIC_BASE_URL=

# API storage mode. Use "local" for development or "b2" for Backblaze.
SPATIALIZE_STORAGE_BACKEND=local
SPATIALIZE_LOCAL_DATA_DIR=backend/.local-data
SPATIALIZE_MAX_UPLOAD_BYTES=20971520

# Required only when SPATIALIZE_STORAGE_BACKEND=b2.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=

# AI providers. Everything degrades gracefully when unset.
# Gemini powers the vision extractor, the voice agent, and TTS.
GEMINI_API_KEY=
# AssemblyAI powers speech-to-text for voice questions (needs b2 storage).
ASSEMBLYAI_API_KEY=
# Optional narration fallback tier (Sarvam Bulbul TTS, api.sarvam.ai).
SARVAM_API_KEY=
# Optional: route the agent + vision extraction through OpenRouter instead of
# Gemini (OpenAI-compatible). TTS still needs GEMINI_API_KEY.
OPENROUTER_API_KEY=
SPATIALIZE_OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional model overrides.
SPATIALIZE_GEMINI_AGENT_MODEL=gemini-flash-latest
SPATIALIZE_GEMINI_VISION_MODEL=gemini-flash-latest
SPATIALIZE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
SPATIALIZE_TTS_VOICE=Sulafat
SPATIALIZE_STT_MODEL=universal-3-5-pro

# Optional. When set, approving or declining an agent proposal requires this value
# in the X-Venue-Token header. A reviewer supplies it once by opening the app
# with ?venue=<token>; the browser remembers it. Leave unset for an open demo.
SPATIALIZE_VENUE_TOKEN=
